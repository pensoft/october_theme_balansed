// ===========================================================================
//  Results (library) - pages/library.htm, partials/balansed/doc-card.htm
//  Uses the sand .bl-news-page band from news.less.
// ===========================================================================

// Tabs: navy outline, the current one solid blue.
.bl-results-page {
    .bl-btn--tab {
        border-color: @bl-navy-35;
        color: @bl-navy;

        &:hover,
        &:focus-visible {
            border-color: @bl-navy;
            color: @bl-navy;
        }

        &.is-active {
            border-color: @bl-blue;
            background: @bl-blue;
            color: @bl-sand;
        }
    }
}

.bl-docs {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 25px;
}

.bl-doc {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 23px;
    min-height: 349px;
    padding: 35px;
    border-radius: @bl-radius-card;
    background: @bl-navy;
    color: @bl-sand;

    // Sand notch holding the round button.
    &::after {
        content: "";
        position: absolute;
        top: 0;
        right: -1px;
        width: 65px;
        height: 59px;
        border-radius: 0 0 33px 33px;
        background: @bl-sand;
    }

    &__type {
        padding: 4px 10px;
        border-radius: @bl-pill;
        background: @bl-sand;
        font-family: @bl-font-display;
        font-size: 10px;
        font-weight: 500;
        line-height: 1.25;
        letter-spacing: -0.1px;
        color: @bl-navy;
    }

    &__title {
        max-width: 325px;
        padding-right: 20px;
        font-size: 18px;
        line-height: 1.3;
        letter-spacing: -0.9px;
    }

    &__rows {
        display: flex;
        flex-direction: column;
        gap: 23px;
        width: 100%;
        margin: 0;
        font-family: @bl-font-display;
        font-size: 16px;
        line-height: 1.3;

        div {
            display: grid;
            grid-template-columns: 70px minmax(0, 1fr);
            gap: 23px;
        }

        dt {
            font-weight: 400;
            letter-spacing: -0.8px;
        }

        dd {
            margin: 0;
            letter-spacing: -0.64px;
            opacity: .55;
            overflow-wrap: anywhere;
        }
    }

    // Covers the card; the round button sits in the notch.
    &__link {
        position: absolute;
        inset: 0;
        z-index: 1;
        border-radius: @bl-radius-card;

        &:focus-visible {
            outline: 2px solid @bl-blue;
            outline-offset: 3px;
        }
    }

    &__btn {
        position: absolute;
        top: 3px;
        right: 5px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 46px;
        height: 46px;
        border-radius: 50%;
        background: @bl-blue;
        color: @bl-sky;
        .bl-arrow-btn();
    }

    &:hover .bl-doc__btn,
    .bl-doc__link:focus-visible .bl-doc__btn {
        .bl-arrow-btn-hover(@bl-blue; rgba(1, 103, 191, .35));
    }
}
@media @bl-lg {
    .bl-docs {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 20px;
    }
}

@media @bl-md {
    .bl-docs {
        grid-template-columns: minmax(0, 1fr);
    }

    .bl-doc {
        min-height: 0;
        padding: 28px;
    }
}
