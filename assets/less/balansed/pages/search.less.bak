// ===========================================================================
//  Search results - pages/search.htm
//  On the sand content band (.bl-band): the search box, a status line, jump
//  links per result type (the News tab pills), then the groups - each
//  result a row: type and date, the linked title, a short excerpt.
//  Scoped under .bl-search-page so it beats the heading / paragraph reset
//  (body.bl h2, body.bl p { margin: 0 }).
// ===========================================================================

@bl-teal-12: rgba(39, 85, 106, .12);

.bl-search-page {
    &__wrap {
        max-width: 1000px + 160px;   // a readable column (bl-wrap adds the gutters)
    }

    // -- Search box: a white pill, icon, field and a navy button ----------
    .bl-search-box {
        display: flex;
        align-items: center;
        gap: 12px;
        height: 60px;
        margin: 0;
        padding: 0 6px 0 22px;
        border: 1px solid @bl-navy-35;
        border-radius: @bl-pill;
        background: @bl-white;
        transition: border-color .2s ease;

        &:focus-within {
            border-color: @bl-navy;
        }

        &__icon {
            display: inline-flex;
            flex: none;
            color: @bl-teal;
        }

        &__input {
            flex: 1 1 auto;
            min-width: 0;
            height: 100%;
            margin: 0;
            padding: 0;
            border: 0;
            background: transparent;
            font-family: @bl-font-body;
            font-size: 18px;
            color: @bl-navy;
            -webkit-appearance: none;
            appearance: none;

            &::placeholder {
                color: @bl-navy;
                opacity: .5;
            }

            &::-webkit-search-cancel-button {
                -webkit-appearance: none;
            }
        }

        &__btn {
            flex: none;
            height: 48px;
            margin: 0;
            padding: 0 26px;
            border: 0;
            border-radius: @bl-pill;
            background: @bl-navy;
            font-family: @bl-font-display;
            font-size: 16px;
            font-weight: 500;
            letter-spacing: -0.16px;
            color: @bl-sand;
            cursor: pointer;
            transition: background-color .25s ease;

            &:hover,
            &:focus-visible {
                background: @bl-teal;
            }
        }
    }

    // -- Status line and jump links ---------------------------------------
    .bl-search-page__status {
        margin: 28px 0 0;

        strong {
            font-weight: 500;
        }
    }

    .bl-search-page__jump {
        margin: 24px 0 0;

        .bl-btn--tab {
            gap: 8px;
        }
    }

    .bl-search-page__n {
        min-width: 24px;
        padding: 2px 8px;
        border-radius: @bl-pill;
        background: @bl-teal-12;
        font-size: 12px;
        line-height: 1.4;
    }

    // -- Result groups ---------------------------------------------------------
    .bl-results {
        margin-top: 56px;
        scroll-margin-top: 24px;    // the jump links land just above the heading
    }

    .bl-results__title {
        display: flex;
        align-items: center;
        gap: 12px;
        margin: 0;
        font-size: 28px;
        line-height: 1.25;
        letter-spacing: -0.6px;
    }

    .bl-results__count {
        padding: 3px 10px;
        border-radius: @bl-pill;
        background: @bl-teal-12;
        font-family: @bl-font-body;
        font-size: 14px;
        line-height: 1.4;
        letter-spacing: 0;
        color: @bl-teal;
    }

    .bl-results__list {
        margin: 16px 0 0;
        padding: 0;
        border-top: 1px solid @bl-navy-15;
        list-style: none;
    }

    // -- One result -------------------------------------------------------------
    .bl-result {
        margin: 0;
        padding: 22px 0 24px;
        border-bottom: 1px solid @bl-navy-15;
    }

    .bl-result__meta {
        display: flex;
        flex-wrap: wrap;
        gap: 4px 12px;
        margin: 0 0 6px;
        font-family: @bl-font-display;
        font-size: 12px;
        font-weight: 500;
        line-height: 1.4;
        letter-spacing: .6px;
        text-transform: uppercase;
        color: @bl-teal;
    }

    .bl-result__date {
        color: fade(@bl-navy, 70%);
    }

    .bl-result__title {
        margin: 0;
        font-size: 22px;
        line-height: 1.3;
        letter-spacing: -0.5px;

        a {
            color: @bl-navy;
            text-decoration: none;

            &:hover,
            &:focus-visible {
                text-decoration: underline;
                text-underline-offset: 3px;
            }
        }
    }

    .bl-result__text {
        display: -webkit-box;
        max-width: 780px;
        margin: 8px 0 0;
        overflow: hidden;
        font-family: @bl-font-body;
        font-size: 16px;
        line-height: 1.55;
        color: fade(@bl-navy, 78%);
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
    }

    // Matched words: a soft green marker instead of the browser's yellow.
    mark {
        padding: 0 2px;
        border-radius: 3px;
        background: fade(@bl-green, 28%);
        color: inherit;
    }
}

@media @bl-md {
    .bl-search-page {
        .bl-search-box {
            height: 54px;
            padding-left: 16px;

            &__input { font-size: 16px; }
            &__btn {
                height: 44px;
                padding: 0 18px;
            }
        }

        .bl-results { margin-top: 44px; }
        .bl-results__title { font-size: 24px; }
        .bl-result__title { font-size: 19px; }
    }
}
