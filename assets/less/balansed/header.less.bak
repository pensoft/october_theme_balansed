// ===========================================================================
//  Header: logo, expanding search pill, menu button + side drawer.
//  The bar is laid over the top of the page (homepage hero / inner banner).
// ===========================================================================

.bl-header {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
    padding: 70px 70px 0;
    color: @bl-sand;
    pointer-events: none;   // let the hero underneath stay interactive

    &__inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 24px;
        max-width: 1298px + 2 * 71px;
        margin: 0 auto;
    }

    &__brand,
    &__actions {
        pointer-events: auto;
    }

    &__brand {
        display: inline-flex;
        color: @bl-sand;
        text-decoration: none;

        &:hover,
        &:focus-visible {
            color: @bl-white;
            text-decoration: none;
        }
    }

    &__actions {
        position: relative;
        display: flex;
        align-items: center;
        gap: 15px;
    }
}

// -- Search pill -----------------------------------------------------------
// Collapsed: only the 70x37 navy button shows. Open (hover, focus or after
// the first click): the glass field with "Search content" slides out.
.bl-search {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    width: 445px;
    height: 50px;
    margin: 0;
    padding: 0 6.75px 0 20px;
    border: 1px solid transparent;
    border-radius: @bl-pill;
    pointer-events: none;
    transition: background-color .3s ease, border-color .3s ease, backdrop-filter .3s ease;

    &__input {
        flex: 1 1 auto;
        min-width: 0;
        height: 100%;
        margin: 0;
        padding: 0;
        border: 0;
        outline: 0;
        background: transparent;
        color: @bl-sky;
        font-family: @bl-font-body;
        font-size: 16px;
        letter-spacing: -0.32px;
        opacity: 0;
        transition: opacity .25s ease;
        -webkit-appearance: none;
        appearance: none;

        &::placeholder {
            color: @bl-sky;
            opacity: .35;
        }

        &::-webkit-search-cancel-button {
            -webkit-appearance: none;
        }

        // No ring of its own while typing: the open pill's border already
        // shows the field is active. Overrides the global focus ring
        // (components/accessibility.less, !important).
        &:focus,
        &:focus-visible {
            outline: 0 !important;
            box-shadow: none !important;
        }
    }

    &__btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        flex: none;
        width: 70px;
        height: 37px;
        margin: 0;
        padding: 0;
        border: 0;
        border-radius: @bl-pill;
        background: @bl-navy;
        color: @bl-sand;
        cursor: pointer;
        pointer-events: auto;
        transition: background-color .25s ease;

        // Figma "Search button": a touch lighter navy.
        &:hover,
        &:focus-visible {
            background: #00213D;
            color: @bl-sand;
        }
    }

    &:hover,
    &:focus-within,
    &.is-open {
        border-color: @bl-sky-35;
        background: @bl-navy-15;
        -webkit-backdrop-filter: blur(27.5px);
        backdrop-filter: blur(27.5px);
        pointer-events: auto;

        .bl-search__input {
            opacity: 1;
        }
    }
}

// -- Menu button -------------------------------------------------------------
.bl-menu-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: none;
    width: 50px;
    height: 50px;
    margin: 0;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: @bl-sand;
    color: @bl-navy;
    cursor: pointer;
    transition: background-color .25s ease, box-shadow .3s ease;

    // Figma "Menu": lighter sand + glow.
    &:hover,
    &:focus-visible {
        background: #F9EFE5;
        box-shadow: 0 .5px 25px 0 @bl-sand-35;
    }
}

// -- Drawer -------------------------------------------------------------------
.bl-drawer {
    position: fixed;
    inset: 0;
    z-index: 1000;

    &[hidden] {
        display: none;
    }

    &__backdrop {
        position: absolute;
        inset: 0;
        background: rgba(0, 22, 41, 0.85);
        opacity: 0;
        transition: opacity .35s ease;
        cursor: pointer;
    }

    &__panel {
        position: absolute;
        top: 0;
        right: 0;
        bottom: 0;
        width: 390px;
        max-width: 100%;
        padding: 55px;
        overflow-y: auto;
        border-radius: 55px 0 0 0;
        background: @bl-sand;
        color: @bl-navy;
        outline: 0;
        transform: translateX(100%);
        transition: transform .35s @bl-ease;
    }

    &__close {
        position: absolute;
        top: 55px;
        right: 55px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 25px;
        height: 25px;
        margin: 0;
        padding: 0;
        border: 0;
        background: none;
        color: @bl-navy;
        cursor: pointer;
        transition: transform .25s @bl-ease;

        &:hover,
        &:focus-visible {
            transform: rotate(90deg);
        }
    }

    &.is-open {
        .bl-drawer__backdrop {
            opacity: 1;
        }

        .bl-drawer__panel {
            transform: none;
        }
    }

    .bl-reduced-motion({
        .bl-drawer__backdrop,
        .bl-drawer__panel {
            transition: none;
        }
    });
}

// Drawer links (partials/menu/default.htm): 20px Sora at 35%, full navy
// when hovered or current. Only parents carry an arrow.
.bl-nav {
    display: flex;
    flex-direction: column;
    gap: 20px;
    margin: 0;
    padding: 0;
    list-style: none;

    // Sub-links: the wrapper animates its height (grid rows 0fr -> 1fr), a
    // thin guide line draws down and the links slide in one after another.
    &__sub-wrap {
        display: grid;
        grid-template-rows: 1fr;
        transition: grid-template-rows .5s @bl-ease, visibility 0s linear 0s;
    }

    // Sub-links (Figma "Menu buttons", open state): flush left under the
    // parent, 20px apart, in the menu's 35% navy.
    &__sub {
        display: flex;
        flex-direction: column;
        gap: 20px;
        min-height: 0;
        margin: 0;
        padding: 20px 0 2px;
        overflow: hidden;
        list-style: none;

        li {
            transition: opacity .35s ease, transform .5s @bl-ease;
            transition-delay: ~"calc(.12s + var(--i, 0) * .06s)";
        }
    }

    // Parent label: full navy, with an arrow pointing down-right when closed
    // that turns up-right when the sub-links are open.
    &__toggle {
        margin: 0;
        padding: 0;
        border: 0;
        background: none;
        text-align: left;
        cursor: pointer;
    }

    &__arrow {
        display: inline-flex;
        flex: none;
        transform: rotate(90deg);   // the up-right arrow turned down-right
        transition: transform .45s @bl-ease;
    }

    &__item.is-open > .bl-nav__toggle .bl-nav__arrow {
        transform: rotate(0deg);    // up-right
    }

    // Colours with the .bl-nav prefix so they beat the base "a { color:
    // inherit }" (Figma "Menu buttons"): every item rests at 35% navy and
    // turns full navy on hover, when current, or (parents) when open.
    .bl-nav__link {
        color: @bl-navy-35;

        &:hover,
        &:focus-visible,
        &.is-active,
        &[aria-current="page"] {
            color: @bl-navy;
        }
    }

    .bl-nav__item.is-open > .bl-nav__toggle,
    .bl-nav__item.is-active > .bl-nav__link {
        color: @bl-navy;
    }

    li {
        margin: 0;
        padding: 0;
    }

    &__link {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        font-family: @bl-font-display;
        font-size: 20px;
        font-weight: 400;
        line-height: 1.25;
        letter-spacing: -1px;
        color: @bl-navy-35;
        text-decoration: none;
        transition: color .25s ease;

        &:hover,
        &:focus-visible {
            text-decoration: none;
        }

        &--label {
            cursor: default;
        }
    }
}

// Collapsed state (JS only - without JS every section stays open).
html.bl-js .bl-nav__item--parent:not(.is-open) {
    .bl-nav__sub-wrap {
        grid-template-rows: 0fr;
        visibility: hidden;   // keeps the hidden links out of the tab order
        transition: grid-template-rows .4s @bl-ease, visibility 0s linear .4s;
    }

    .bl-nav__sub li {
        opacity: 0;
        transform: translateX(-14px);
        transition-delay: 0s;
    }
}

.bl-reduced-motion({
    .bl-nav__sub-wrap,
    .bl-nav__sub li,
    .bl-nav__arrow {
        transition: none !important;
    }
});

// -- Responsive ----------------------------------------------------------------
@media @bl-xl {
    .bl-header {
        padding: 40px @bl-gutter 0;
    }

    .bl-search {
        width: 340px;
    }
}

@media @bl-md {
    .bl-header {
        padding-top: 24px;
    }

    .bl-search {
        width: 70px;
        padding: 0;
        border: 0;

        // Open on phones: the field spans the bar, over the logo.
        &:focus-within,
        &.is-open {
            position: absolute;
            right: 0;
            width: ~"calc(100vw - 40px)";
            padding: 0 6px 0 18px;
            border: 1px solid @bl-sky-35;
            background: fade(@bl-navy, 85%);
        }

        &:hover:not(:focus-within):not(.is-open) {
            border: 0;
            background: none;
            backdrop-filter: none;

            .bl-search__input {
                opacity: 0;
            }
        }
    }

    .bl-drawer__panel {
        width: 100%;
        padding: 40px 28px;
        border-radius: 32px 0 0 0;
    }

    .bl-drawer__close {
        top: 40px;
        right: 28px;
    }
}

// Small phones: logo + search + menu must fit 320px. The bar is positioned
// against the page (not clipped by .bl-site), so anything wider than the
// screen would widen the whole page and push the menu button off it.
@media @bl-sm {
    .bl-header {
        &__inner {
            gap: 12px;
        }

        &__actions {
            gap: 8px;
        }

        .bl-logo {
            gap: 5px;

            &__mark {
                width: 40px;
                height: 40px;
                border-width: 2.2px;

                svg {
                    width: 22px;
                    height: 24px;
                }
            }

            &__word {
                font-size: 22px;
                letter-spacing: -0.66px;
            }
        }
    }

    .bl-search,
    .bl-search__btn {
        width: 50px;
    }

    .bl-menu-btn {
        width: 44px;
        height: 44px;
    }
}
