description = "Default layout"

[SeoCmsPage]

[session]
security = "all"

[metaList]
includePageMeta = 1
escape = 1
==
{#
    BALANSED layout.

    Pages in rl_designed render their own hero and sections. Every other page
    (privacy, cookies, search, login, static pages...) gets the inner-page
    banner with its title (partials/realise/page-hero.htm) and its content
    inside .bl-legacy.

    The header (partials/site/header.htm) is laid over the top of every page;
    the footer (partials/site/footer.htm) is the same on every page.

    Styles: assets/less/theme.less - the base Pensoft styles for plugin
    markup, then the BALANSED look in assets/less/balansed/.
    Behaviour: assets/js/balansed.js.
#}
{% set rl_designed = ['home', 'about', 'partners', 'news', 'events', 'library', 'study-regions', 'work-packages', 'contact', 'media-center', 'newsletter', 'search'] %}
{% set rl_is_designed = this.page.id in rl_designed %}
<!DOCTYPE html>
<html lang="{{ currentLang|default('en') }}">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    {% component 'SeoCmsPage' %}
    {# Favicon: the theme setting "Site icon" when uploaded, else the
       BALANSED scales mark. #}
    {% if this.theme.site_icon %}
    <link rel="icon" href="{{ this.theme.site_icon.getPath() }}">
    {% else %}
    <link rel="icon" type="image/svg+xml" href="{{ 'assets/images/balansed/favicon.svg'|theme }}">
    {% endif %}
    <meta name="theme-color" content="#001629">

    <link rel="preload" href="{{ 'assets/fonts/balansed/sora-latin.woff2'|theme }}" as="font" type="font/woff2" crossorigin>
    <link href="{{ ['assets/less/theme.less']|theme }}" rel="stylesheet">
    {# bl-js: JS is on. bl-motion: scroll-triggered motion is allowed, so the
       "before" states of assets/less/balansed/motion.less apply from the
       first paint. Failsafe: if balansed.js has not started within 4s, the
       motion class is dropped and everything shows. #}
    <script>
        (function (d, w) {
            var c = d.documentElement.classList;
            c.add('bl-js');
            if ('IntersectionObserver' in w && !(w.matchMedia && w.matchMedia('(prefers-reduced-motion: reduce)').matches)) {
                c.add('bl-motion');
                setTimeout(function () { if (!w.blRevealReady) c.remove('bl-motion'); }, 4000);
                // Mid study-region trip (zoomOpen / zoomBack in balansed.js):
                // flag it from the first paint - the overview's section starts
                // navy, the region page's content waits for its arrival.
                try {
                    if (w.sessionStorage.getItem('bl-region-trip')) {
                        c.add('bl-region-enter');
                        setTimeout(function () { c.remove('bl-region-enter'); }, 4000);
                    }
                } catch (e) {}
            }
        })(document, window);
    </script>

    <script src="{{ 'assets/js/jquery.js'|theme }}"></script>
    {# Theme scripts go through the asset combiner (array form) so their URL
       changes whenever the file changes - no stale copies in browser caches. #}
    <script src="{{ ['assets/js/app.js']|theme }}"></script>
    <script src="{{ ['assets/js/accessibility.js']|theme }}"></script>
    <script src="{{ 'assets/vendor/bootstrap/js/modal.js'|theme }}"></script>
    <script src="{{ 'assets/js/slick.min.js'|theme }}"></script>
    <script src="{{ ['assets/js/balansed.js']|theme }}" defer></script>

    <script src="https://www.google.com/recaptcha/api.js" async defer></script>

<!-- Google Tag Manager -->
<script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
})(window,document,'script','dataLayer','GTM-PWW5NKQ');</script>
<!-- End Google Tag Manager -->

    {% if (this.page.id == 'news' or this.page.id == 'blog') and is_detail_page %}
        {% component 'metaList' includePageMeta=false %}
    {% else %}
        {% component 'metaList' %}
    {% endif %}

    {% framework extras %}
    {% styles %}
    {% scripts %}
    <!-- Matomo -->
<script>
  var _paq = window._paq = window._paq || [];
  /* tracker methods like "setCustomDimension" should be called before "trackPageView" */
  /* .eps and .svg are not in Matomo's default download extension list */
  _paq.push(['addDownloadExtensions', 'eps|svg']);
  _paq.push(['trackPageView']);
  _paq.push(['enableLinkTracking']);
  (function() {
    var u="//matomo.pensoft.net/";
    _paq.push(['setTrackerUrl', u+'matomo.php']);
    _paq.push(['setSiteId', '81']);
    var d=document, g=d.createElement('script'), s=d.getElementsByTagName('script')[0];
    g.async=true; g.src=u+'matomo.js'; s.parentNode.insertBefore(g,s);
  })();
</script>
<!-- End Matomo Code -->
</head>

<body class="bl bl-page-{{ this.page.id }}" data-current-lang="{{ currentLang }}">
<a class="skip-link" href="#layout-content">Skip to main content</a>

<!-- Polite live region used to announce filter, pagination and toast updates -->
<div id="a11y-announcer" class="sr-only" aria-live="polite" aria-atomic="true"></div>

<!-- Google Tag Manager (noscript) -->
<noscript><iframe title="Google Tag Manager" src="https://www.googletagmanager.com/ns.html?id=GTM-PWW5NKQ"
height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
<!-- End Google Tag Manager (noscript) -->

<div class="bl-site">
    {% partial 'site/header'
        site_name=this.theme.site_name
        page_id=this.page.id
    %}

    <main id="layout-content" class="bl-main {{ this.page.id }}" tabindex="-1">
        {% if rl_is_designed %}
            {% page %}
        {% else %}
            {# These pages print their own <h1>; the banner title then renders
               as a visually identical non-heading so each page has one H1. #}
            {% set rl_own_h1 = this.page.id in ['404', 'error'] %}
            {% partial 'balansed/page-hero' title=(this.page.title ?: this.theme.site_name) heading=(not rl_own_h1) %}
            <div class="bl-band">
                <div class="bl-wrap bl-legacy">
                    {% page %}
                </div>
            </div>
        {% endif %}
    </main>

    {% if this.theme.enable_footer %}
    <footer class="bl-footer">
        {% partial 'site/footer'
            footer_funds_flag=(this.theme.footer_funds_flag ? this.theme.footer_funds_flag.getPath() : null)
        %}
    </footer>
    {% endif %}
</div>

<div id="gdpr-reload">
    {% partial 'gdpr' %}
</div>

</body>
</html>
