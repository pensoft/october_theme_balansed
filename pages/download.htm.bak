title = "File download"
url = "/files/:id/:name?"
is_hidden = 0
robot_index = "noindex"
robot_follow = "nofollow"
==
<?php
use System\Models\File;

/*
 * /files/<file id>/<original file name> - serves any public attachment
 * (library, media logos, flyers, newsletters...) under its original name.
 * Links are built by partials/components/download-url.htm.
 *
 * Not /download/...: Pensoft.Library registers its own /download/{id}/{name}
 * route, which takes precedence over CMS pages and only serves the models in
 * its config (Library by default) - Media files 404'd there.
 */
function onStart()
{
	$id = (int) $this->param('id');

	$file = $id ? File::find($id) : null;

	/*
	 * Only public attachments may pass through here. Protected files keep
	 * going through the backend Files controller, which does its own auth.
	 */
	if (!$file || !$file->isPublic()) {
		abort(404);
	}

	$localPath = $file->getLocalPath();

	if (!$localPath || !file_exists($localPath)) {
		abort(404);
	}

	// One canonical URL per file: a missing or outdated name segment
	// redirects to the current original file name.
	$canonical = str_replace(['/', '\\'], '-', trim((string) $file->file_name)) ?: ('file-' . $file->id);
	if (rawurldecode((string) $this->param('name')) !== $canonical) {
		return Redirect::to($this->pageUrl('download', ['id' => $file->id, 'name' => $canonical], false), 301);
	}

	$headers = [];

	if ($contentType = $file->getContentType()) {
		$headers['Content-Type'] = $contentType;
	}

	// The disk name is a hash, so the bytes behind an id never change.
	$headers['Cache-Control'] = 'public, max-age=86400';

	$response = Response::file($localPath, $headers);

	/*
	 * Symfony rejects slashes in the file name, and needs an ASCII fallback
	 * for user agents that cannot read the RFC 5987 "filename*" form.
	 */
	$fileName = str_replace(['/', '\\'], '-', $file->file_name);
	$fallback = preg_replace('/[^\x20-\x7e]/', '_', Str::ascii($fileName));
	$fallback = str_replace(['%', '/', '\\'], '_', $fallback) ?: 'download';

	/*
	 * PDFs and raster images are shown in the browser as a preview (links to
	 * them open in a new tab, see partials/realise/file-link.htm); every other
	 * type is downloaded. SVG stays a download: shown inline on this origin it
	 * could run script. In both cases the name the browser uses - tab title,
	 * save dialog - is the original upload name.
	 */
	$ext = strtolower($file->getExtension());
	$preview = in_array($ext, ['pdf', 'png', 'jpg', 'jpeg', 'gif', 'webp'], true) || $file->getContentType() === 'application/pdf';
	$response->setContentDisposition($preview ? 'inline' : 'attachment', $fileName, $fallback);
	$response->headers->set('X-Content-Type-Options', 'nosniff');

	return $response;
}
?>
==
